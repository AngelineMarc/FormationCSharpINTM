<PageFunction
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    x:Class="Or.Pages.AjoutBeneficiaire"
    x:TypeArguments="sys:Int64"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Or.Pages"
    mc:Ignorable="d"
    d:DesignHeight="450" d:DesignWidth="800"
    Title="AjoutBeneficiaire">
    <Grid>
        <TextBlock x:Name="Ajoutbeneficiaire" HorizontalAlignment="Left" Margin="100,85,0,0" TextWrapping="Wrap" Text="Ajouter un bénéficiare" VerticalAlignment="Top" FontSize="20" FontWeight="SemiBold"/>

        <Label x:Name="labelCpt" Content="N° de compte du nouveau bénéficiare" HorizontalAlignment="Left" Margin="100,180,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.237,0.385"/>
        <TextBox x:Name="CptBeneficiaire" HorizontalAlignment="Left" Margin="100,210,0,0" VerticalAlignment="Top" Width="120" Height="22" TextAlignment="Right" TextWrapping="Wrap"/>

        <Button x:Name="Ajout" Content="Ajouter un bénéficiaire" HorizontalAlignment="Left" Margin="500,210,0,0" VerticalAlignment="Top" Width="200" Height="30" Click="Ajout_Beneficiaire"/>

        <Button x:Name="Retour" Content="Retour" HorizontalAlignment="Left" Margin="100,330,0,0" VerticalAlignment="Top" Height="30" Width="80" Click="Retour_Click"/>
        
    </Grid>
</PageFunction>
